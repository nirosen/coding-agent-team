# Required
CURSOR_API_KEY=cursor_...

# Signed control is required unless the CLI is launched with --no-steer.
# CODING_AGENT_CONTROL_PUBLIC_KEY=/absolute/path/controller.pub
# CODING_AGENT_CONTROL_ROOT=/absolute/path/control-root

# Slack HITL (optional; all three are required for inbound decisions)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C...
SLACK_ALLOWED_USER_IDS=U...
# Optional allowlisted, run-targeted Slack steering
SLACK_STEER_ENABLED=false
# Optional one-way alerts only (cannot read replies)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
